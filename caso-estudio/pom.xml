<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Versión del modelo POM de Maven -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Identificadores únicos del proyecto (Grupo 15 - UPTC) -->
  <groupId>co.edu.uptc</groupId>
  <artifactId>caso-estudio</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>caso-estudio</name>
  <url>http://maven.apache.org</url>

  <!-- Propiedades de compilación y codificación de caracteres -->
  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Dependencias del proyecto -->
  <dependencies>
    <!-- Framework de pruebas unitarias (Pruebas de programador) -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>

    <!-- Librería Gson para serialización y deserialización en persistencia JSON -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>

    <!-- Conector JDBC para la persistencia en base de datos MySQL -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>
  </dependencies>

  <!-- Configuración de plugins de construcción -->
  <build>
    <plugins>
      <!-- Plugin compilador de Maven configurado para Java 25 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>