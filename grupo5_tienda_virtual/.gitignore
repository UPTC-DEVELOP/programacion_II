# =========================================================
# .gitignore - Tienda Virtual de Libros
# =========================================================

# --- Compilados de Java ---
*.class
*.jar
*.war
*.ear
*.nar

# --- Carpetas de compilacion / salida ---
bin/
build/
out/
target/
dist/
classes/

# --- Archivos de datos generados por el programa ---
datos/
*.log

# --- IntelliJ IDEA ---
.idea/
*.iml

# --- VS Code ---
.vscode/

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Backups y temporales ---
*.bak
*.tmp
*.swp
~$*

# --- Planes internos (solo local, no se publican) ---
docs/DAD_FINAL_U4/
docs/PLAN_*.md
docs/GUION_SUSTENTACION.md
docs/PRUEBAS_CLIENTES.md
docs/PRUEBAS_COMPRAS.md
docs/TAREAS_PENDIENTES.md
docs/TAREAS_UNIDAD3.md
